{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeo.local/framework/schema/report.schema.json",
  "title": "AVR Diagnostic Report",
  "description": "AVR(AI Visibility & Readiness) 진단 리포트 산출물 스키마. Plane A(visibility) + Plane B(readiness) + gap_quadrant. pillar/item/channel id는 framework/rubric/pillars.yaml, framework/rubric/channels.yaml 과 반드시 일치한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "generated_at",
    "rubric_version",
    "channels_version",
    "subject",
    "plane_a",
    "plane_b",
    "gap_quadrant"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.5.0"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "rubric_version": {
      "type": "string",
      "description": "채점에 사용한 pillars.yaml 의 version",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "channels_version": {
      "type": "string",
      "description": "집계에 사용한 channels.yaml 의 version",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "scoring_version": {
      "type": "string",
      "description": "판정에 사용한 scoring.yaml(임계값·계수) 의 version. scoring.md §3.2 는 rubric_version 과 별도로 scoring 규칙 버전을 리포트에 남길 것을 요구한다 — 임계값이 바뀌면 같은 점수가 다른 사분면으로 판정되기 때문이다.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "probe_config": {
      "$ref": "#/$defs/probe_config"
    },
    "plane_a": {
      "$ref": "#/$defs/plane_a"
    },
    "plane_b": {
      "$ref": "#/$defs/plane_b"
    },
    "gap_quadrant": {
      "$ref": "#/$defs/gap_quadrant"
    },
    "comparison": {
      "$ref": "#/$defs/comparison",
      "description": "직전 측정 대비 변화와 유의성 검정. 최초 진단에서는 생략한다."
    },
    "limitations": {
      "type": "array",
      "description": "공시 의무 항목. 프록시 격차, API 미보유 채널의 수집 방식, 미측정 채널 등을 반드시 기재한다.",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "channel_id": {
      "type": "string",
      "enum": [
        "chatgpt",
        "gemini",
        "naver_ai_briefing",
        "claude",
        "perplexity",
        "google_ai_overviews"
      ]
    },
    "pillar_id": {
      "type": "string",
      "enum": [
        "P1",
        "P2",
        "P3",
        "P4",
        "P5"
      ]
    },
    "item_id": {
      "type": "string",
      "enum": [
        "P1-01",
        "P1-02",
        "P1-03",
        "P1-04",
        "P1-05",
        "P1-06",
        "P1-07",
        "P1-08",
        "P1-09",
        "P1-10",
        "P2-01",
        "P2-02",
        "P2-03",
        "P2-04",
        "P2-05",
        "P2-06",
        "P2-07",
        "P2-08",
        "P2-09",
        "P2-10",
        "P3-01",
        "P3-02",
        "P3-03",
        "P3-04",
        "P3-05",
        "P3-06",
        "P3-07",
        "P3-08",
        "P3-09",
        "P4-01",
        "P4-02",
        "P4-03",
        "P4-04",
        "P4-05",
        "P4-06",
        "P4-07",
        "P4-08",
        "P4-09",
        "P5-01",
        "P5-02",
        "P5-03",
        "P5-04",
        "P5-05",
        "P5-06",
        "P5-07"
      ]
    },
    "unit_interval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "unavailable_kind": {
      "type": "string",
      "enum": [
        "not_applicable",
        "design_limit",
        "inconclusive",
        "no_collector",
        "input_missing",
        "awaiting_manual"
      ],
      "description": "score 가 null 인 이유의 6분류 (spec plane-b-readiness.md §8.2, schema_version 1.2.0 이후). 분모(judgeable)에서 빼는 기준은 하나뿐이다 — '판정 대상이 사이트에 성립하지 않으면 뺀다. 우리가 모르면 남긴다.' not_applicable·design_limit 은 이 기준에 따라 커버리지 분모에서 제외되고, inconclusive·no_collector·input_missing·awaiting_manual 은 분모에 남는다(측정 실패를 좋은 점수로 둔갑시키지 않기 위함). 값이 비어 있으면 inconclusive 와 동일하게 분모에 포함해 처리한다 — 애매하면 남기는 쪽이 기본값이다.",
      "$comment": "not_applicable=판정 대상이 사이트에 존재하지 않음(예: 외부 링크 0건). design_limit=단일 관측으로는 원리상 판정 불가(예: 시계열 필요). inconclusive=대상은 있으나 확인 실패(예: unchecked 과반). no_collector=수집기 미구현(로드맵). input_missing=필요한 정식 입력이 없음(예: extra_urls, 질문 세트). awaiting_manual=check:manual 항목의 사람 판정이 아직 없음(예: P4-02 브랜드 인지도 서베이 미실시) — manual 은 설계상 영구히 사람 티어이므로 no_collector(로드맵 결손)와 섞으면 안 되고, 고객이 대체 입력할 수 없으므로 input_missing 과도 다르다."
    },
    "remediation_tier": {
      "type": "string",
      "enum": [
        "config",
        "dev",
        "content",
        "operations",
        "earned"
      ],
      "description": "이 항목이 미달일 때 누가 고쳐야 하는가의 5분류 (spec plane-b-readiness.md §9, rubric v1.6.0 이후). 채점(score)에는 관여하지 않는 순수 정보 필드다 — 같은 item_id 는 rubric 버전이 같은 한 항상 같은 remediation 을 갖는다. 자동화 가능 여부가 아니라 '어떤 종류의 일인가'로 나눈다.",
      "$comment": "config=사이트 설정·파일 하나로 오늘 끝난다(사이트 관리자). dev=템플릿·코드·인프라 수정(개발자). content=글·자료 작성(콘텐츠 담당). operations=사이트 밖 등록·프로세스·담당자 지정(운영·마케팅). earned=남이 해줘야 한다, 살 수 없고 벌어야 한다(백링크·언론·제3자 언급) — 오늘 실행할 수 없는 일이라는 것 자체가 이 값의 정보다."
    },
    "evidence_grade": {
      "type": "string",
      "enum": [
        "standard",
        "provider_documented",
        "observed",
        "unverified"
      ],
      "description": "이 항목이 재는 **메커니즘의 근거** 강도 (spec plane-b-readiness.md §10, rubric v1.7.0 이후). 채점(score)에는 관여하지 않는 순수 정보 필드다 — 같은 item_id 는 rubric 버전이 같은 한 항상 같은 evidence 를 갖는다. ⚠️ 인과를 주장하지 않는다: standard 라도 '이걸 고치면 AI 답변 노출이 오른다'는 뜻이 아니며, 인과는 avr-model.md §6 의 회귀 전까지 어떤 등급으로도 주장하지 않는다.",
      "$comment": "standard=거버넌스가 있는 표준이 메커니즘을 규정(RFC 9309 robots.txt, RFC 9110 상태코드). provider_documented=AI·검색 제공사 공개 문서가 이 신호를 소비한다고 서술. observed=우리 측정으로 관계를 관측했고 표본 수를 공시할 수 있음 — 현재 0개이며, 유의한 관측이 없어서 비어 있는 것이 정직한 상태다(avr-model.md §5.2 는 n=3, p=0.083). unverified=표준도 제공사 문서도 우리 관측도 없는 업계 관행 — P2·P4 대부분이 여기 속하는 것은 개별 항목의 결함이 아니라 이 분야의 상태다. 리포트는 unverified 항목의 미달을 '반드시 고쳐야 할 결함'으로 제시하지 않는다."
    },
    "score_0_100": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "wilson_ci": {
      "type": "object",
      "description": "이항비율의 Wilson score interval. plane-a-visibility.md §3 참조.",
      "additionalProperties": false,
      "required": [
        "point",
        "lower",
        "upper",
        "n",
        "confidence",
        "method"
      ],
      "properties": {
        "point": {
          "$ref": "#/$defs/unit_interval"
        },
        "lower": {
          "$ref": "#/$defs/unit_interval"
        },
        "upper": {
          "$ref": "#/$defs/unit_interval"
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "successes": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1,
          "default": 0.95
        },
        "method": {
          "type": "string",
          "enum": [
            "wilson"
          ]
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand",
        "domain"
      ],
      "properties": {
        "brand": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "description": "자사가 주장하는 카테고리 정의문의 핵심 명사구"
        },
        "locale": {
          "type": "string",
          "default": "ko-KR"
        },
        "competitors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "brand"
            ],
            "properties": {
              "brand": {
                "type": "string"
              },
              "domain": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "probe_config": {
      "type": "object",
      "description": "Plane A 프로빙 설계. n = questions x repetitions x search_modes 이며 채널별로 달라질 수 있다.",
      "additionalProperties": false,
      "required": [
        "questions",
        "repetitions",
        "search_modes"
      ],
      "properties": {
        "questions": {
          "type": "integer",
          "minimum": 1
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "search_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "on",
              "off"
            ]
          }
        },
        "question_set_id": {
          "type": "string"
        },
        "window_start": {
          "type": "string",
          "format": "date"
        },
        "window_end": {
          "type": "string",
          "format": "date"
        },
        "entity_baseline_correction": {
          "type": "object",
          "description": "대조 프롬프트로 추정한 false-positive rate. 보정 전/후 MR을 모두 남긴다.",
          "additionalProperties": false,
          "required": [
            "applied"
          ],
          "properties": {
            "applied": {
              "type": "boolean"
            },
            "false_positive_rate": {
              "$ref": "#/$defs/unit_interval"
            },
            "control_prompt_n": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "plane_a": {
      "type": "object",
      "description": "Plane A — Visibility. 실제 LLM 응답 프로빙 결과.",
      "additionalProperties": false,
      "required": [
        "avi",
        "coefficients",
        "channels"
      ],
      "properties": {
        "avi": {
          "$ref": "#/$defs/score_0_100",
          "description": "AVI = 100 x Sum_c w_c x (alpha*MR_c + beta*PosScore_c + gamma*CitShare_c). 미측정 채널 제외 후 가중치 재정규화."
        },
        "avi_ci": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lower",
            "upper",
            "confidence",
            "method"
          ],
          "properties": {
            "lower": {
              "$ref": "#/$defs/score_0_100"
            },
            "upper": {
              "$ref": "#/$defs/score_0_100"
            },
            "confidence": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "method": {
              "type": "string",
              "enum": [
                "bootstrap",
                "delta_method"
              ]
            }
          }
        },
        "coefficients": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alpha",
            "beta",
            "gamma"
          ],
          "properties": {
            "alpha": {
              "$ref": "#/$defs/unit_interval",
              "default": 0.5
            },
            "beta": {
              "$ref": "#/$defs/unit_interval",
              "default": 0.3
            },
            "gamma": {
              "$ref": "#/$defs/unit_interval",
              "default": 0.2
            }
          }
        },
        "weight_renormalized": {
          "type": "boolean",
          "description": "미측정 채널을 제외하고 w_c를 재정규화했는지 여부"
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/channel_result"
          }
        },
        "proxy_gap": {
          "type": "array",
          "description": "프록시 격차 delta. 저가 트래킹 모델과 플래그십 캘리브레이션 모델의 MR 차이. 리포트 공시 의무.",
          "items": {
            "$ref": "#/$defs/proxy_gap_entry"
          }
        }
      }
    },
    "channel_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "measured"
      ],
      "properties": {
        "channel_id": {
          "$ref": "#/$defs/channel_id"
        },
        "measured": {
          "type": "boolean",
          "description": "false면 metrics를 생략하고 분모에서 제외한다. AI Overviews 미노출(not_shown)이 대표 사례."
        },
        "not_measured_reason": {
          "type": "string",
          "enum": [
            "not_shown",
            "api_unavailable",
            "rate_limited",
            "tos_blocked",
            "scrape_failed",
            "out_of_scope"
          ]
        },
        "weight": {
          "$ref": "#/$defs/unit_interval"
        },
        "effective_weight": {
          "$ref": "#/$defs/unit_interval",
          "description": "미측정 채널 제외 후 재정규화된 가중치"
        },
        "collection_method": {
          "type": "string",
          "enum": [
            "official_api",
            "serp_scrape",
            "manual_capture"
          ]
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "실제 호출한 모델 식별자. 채널이 버전 핀을 지원하지 않으면 null."
        },
        "model_role": {
          "type": "string",
          "enum": [
            "tracking",
            "calibration",
            "none"
          ]
        },
        "search_mode": {
          "type": "string",
          "enum": [
            "on",
            "off",
            "always_on",
            "mixed"
          ]
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "metrics": {
          "$ref": "#/$defs/visibility_metrics"
        }
      }
    },
    "visibility_metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mr": {
          "$ref": "#/$defs/unit_interval",
          "description": "Mention Rate = 언급 응답 수 / 총 응답 수"
        },
        "mr_ci": {
          "$ref": "#/$defs/wilson_ci"
        },
        "mr_raw": {
          "$ref": "#/$defs/unit_interval",
          "description": "엔티티 baseline 보정 전 MR. 보정을 적용했다면 mr과 함께 반드시 병기."
        },
        "sov": {
          "$ref": "#/$defs/unit_interval",
          "description": "Share of Voice = 자사 언급 / 전체 브랜드 언급"
        },
        "pos_score": {
          "$ref": "#/$defs/unit_interval",
          "description": "언급 순서 가중 평균. 응답별 1/log2(1+rank), 미언급 응답은 0."
        },
        "cit_share": {
          "$ref": "#/$defs/unit_interval",
          "description": "자사 도메인 인용 / 전체 인용 도메인"
        },
        "sentiment_sov": {
          "$ref": "#/$defs/unit_interval",
          "description": "자사 긍정 언급 / 전체 긍정 언급"
        },
        "fai": {
          "$ref": "#/$defs/unit_interval",
          "description": "Fact Accuracy Index = 1 - (오류 진술 수 / 총 진술 수)"
        },
        "fai_sample_size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "proxy_gap_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "tracking_mr",
        "calibration_mr",
        "delta"
      ],
      "properties": {
        "channel_id": {
          "$ref": "#/$defs/channel_id"
        },
        "tracking_model": {
          "type": "string"
        },
        "calibration_model": {
          "type": "string"
        },
        "tracking_mr": {
          "$ref": "#/$defs/unit_interval"
        },
        "calibration_mr": {
          "$ref": "#/$defs/unit_interval"
        },
        "delta": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "delta = tracking_mr - calibration_mr. 부호 포함."
        },
        "calibration_n": {
          "type": "integer",
          "minimum": 1
        },
        "measured_at": {
          "type": "string",
          "format": "date"
        },
        "significant": {
          "type": "boolean",
          "description": "two-proportion z-test 결과 유의(alpha=0.05)하면 true. true면 트래킹 수치를 보정 없이 보고해서는 안 된다."
        }
      }
    },
    "plane_b": {
      "type": "object",
      "description": "Plane B — Readiness. 5 Pillar rubric 채점 결과.",
      "additionalProperties": false,
      "required": [
        "ars",
        "determinate_band",
        "gating",
        "pillars",
        "raw_ars"
      ],
      "properties": {
        "ars": {
          "$ref": "#/$defs/score_0_100",
          "description": "게이팅 적용 후 최종 점수. AEO Readiness Score."
        },
        "raw_ars": {
          "$ref": "#/$defs/score_0_100",
          "description": "게이팅 적용 전 가중합"
        },
        "gating": {
          "$ref": "#/$defs/gating_result",
          "properties": {
            "undetermined": {
              "type": "boolean",
              "description": "blocking 항목을 판정하지 못했다. true 이면 총점을 신뢰할 수 없다 (spec plane-b §4.5)."
            },
            "unscored_blocking_item_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "판정하지 못한 blocking 항목 id"
            }
          },
          "required": [
            "undetermined"
          ]
        },
        "pillars": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/pillar_result"
          }
        },
        "coverage": {
          "type": "object",
          "description": "판정된 항목 수. manual 항목이 미판정이면 해당 항목을 분모에서 제외하고 그 사실을 공시한다. judgeable_count 도입(spec plane-b-readiness.md §2.2) 이후 min_pillar_coverage·min_item_coverage 의 분모는 total_items 가 아니라 judgeable_count 다.",
          "additionalProperties": false,
          "properties": {
            "scored_items": {
              "type": "integer",
              "minimum": 0
            },
            "total_items": {
              "type": "integer",
              "minimum": 1
            },
            "unscored_item_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/item_id"
              }
            },
            "judgeable_count": {
              "type": "integer",
              "minimum": 0,
              "description": "total_items - not_applicable_count - design_limit_count. Pillar 제외 판정(min_pillar_coverage)과 커버리지 하한(min_item_coverage) 판정의 분모다 (spec plane-b-readiness.md §2.2, scoring.md §4.1)."
            },
            "not_applicable_count": {
              "type": "integer",
              "minimum": 0,
              "description": "unavailable_kind = not_applicable 인 항목 수 — 판정 대상이 이 사이트에 존재하지 않아 커버리지 분모에서 제외된 항목."
            },
            "design_limit_count": {
              "type": "integer",
              "minimum": 0,
              "description": "unavailable_kind = design_limit 인 항목 수 — 단일 관측으로는 원리상 판정 불가능해 커버리지 분모에서 제외된 항목."
            },
            "applicability": {
              "$ref": "#/$defs/unit_interval",
              "description": "judgeable_count / total_items. 이 rubric 이 이 사이트에 얼마나 적용 가능한지의 별도 공시 지표다. 낮다고 감점이 아니라 맥락이다 — 측정 성공률을 뜻하는 coverage(scored_items/judgeable_count)와는 다른 숫자이므로 반드시 둘 다 공시한다(spec plane-b-readiness.md §2.2)."
            }
          }
        },
        "unavailable_items": {
          "type": "object",
          "description": "못 잰 항목 id -> 사유. 사유 없는 누락은 허용되지 않는다 (spec plane-b §4.5).",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "remediation_counts": {
          "type": "object",
          "description": "조치 분류(config|dev|content|operations|earned) 별 **채점된** 항목 수 (rubric v1.6.0 이후, spec plane-b-readiness.md §9). 미판정 항목은 세지 않는다 -- 세면 '안 잰 것'이 '할 일'로 둔갑한다.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "evidence_counts": {
          "type": "object",
          "description": "증거 등급(standard|provider_documented|observed|unverified) 별 **채점된** 항목 수 (rubric v1.7.0 이후, spec plane-b-readiness.md §10). 미판정 항목은 세지 않는다 -- 세면 '안 잰 것'이 '근거가 이만큼 있다'로 둔갑한다. 이 분포가 리포트에 없으면 독자는 점수가 얼마나 단단한 근거 위에 있는지 알 수 없다.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "determinate_band": {
          "$ref": "#/$defs/determinate_band"
        }
      }
    },
