        },
        "width": {
          "type": "number",
          "minimum": 0,
          "description": "ceiling - floor. 진단의 완결성을 재는 값이지 사이트 품질이 아니다"
        },
        "unobserved_item_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item_id"
